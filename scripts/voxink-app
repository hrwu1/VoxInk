#!/bin/sh
# Run VoxInk on a source checkout: preflight, start the helper, publish the
# control endpoint, open the menu bar, browser, or shell, and stop the helper on
# exit. This is the signed application's role until that application exists;
# the public `voxink` command only talks to the helper this starts.
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$PROJECT_DIR/.venv/bin/python" ]; then
    echo "VoxInk requires a Python 3.12 environment at $PROJECT_DIR/.venv." >&2
    echo "Create it with: python3.12 -m venv .venv" >&2
    exit 2
fi
exec "$PROJECT_DIR/.venv/bin/python" -m voxink_dev.cli "$@"
