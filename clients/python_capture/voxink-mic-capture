#!/bin/sh
# The portable microphone capture backend. The transcription helper launches
# it in place of the Swift voxink-capture where that is not built; both speak
# the same command line and signals.
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ ! -x "$PROJECT_DIR/.venv/bin/python" ]; then
    echo "VoxInk requires a Python 3.12 environment at $PROJECT_DIR/.venv." >&2
    echo "Create it with: python3.12 -m venv .venv" >&2
    exit 2
fi
exec "$PROJECT_DIR/.venv/bin/python" -m clients.python_capture "$@"
